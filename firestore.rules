rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function text(v, max) {
      return v is string && v.size() <= max;
    }

    function link(v) {
      return text(v, 300) && (v == '' || v.matches('https://.+'));
    }

    function spotKeys() {
      return ['name', 'lake', 'county', 'place', 'lat', 'lng', 'description',
        'hasAccommodation', 'accommodationInfo', 'hasBoats', 'boatInfo', 'species',
        'price', 'fishingLicense', 'website', 'phone', 'email', 'imageUrl',
        'ownerUid', 'source', 'sourceUrl', 'status', 'updatedAt'];
    }

    // Valfria fält: finns bara när de är ifyllda.
    function optionalKeys() {
      return ['address', 'beds', 'boatCount', 'boatCountEstimate', 'petrolMotor', 'electricMotor',
        'licenseRequired', 'fishingLicenseUrl', 'units', 'unitsEstimate', 'bedsEstimate',
        'descriptionEn', 'accommodationInfoEn', 'boatInfoEn', 'priceEn', 'fishingLicenseEn'];
    }

    function validOptional(d) {
      return (!('address' in d) || text(d.address, 200))
        && (!('beds' in d) || (d.beds is int && d.beds >= 1 && d.beds <= 2000))
        && (!('boatCount' in d) || (d.boatCount is int && d.boatCount >= 1 && d.boatCount <= 500))
        && (!('boatCountEstimate' in d) || d.boatCountEstimate is bool)
        // Bostäder: stugor, torp, hus, lägenheter och rum. Uppskattning = "minst".
        && (!('units' in d) || (d.units is int && d.units >= 1 && d.units <= 1000))
        && (!('unitsEstimate' in d) || d.unitsEstimate is bool)
        && (!('bedsEstimate' in d) || d.bedsEstimate is bool)
        && (!('petrolMotor' in d) || d.petrolMotor is bool)
        && (!('electricMotor' in d) || d.electricMotor is bool)
        && (!('licenseRequired' in d) || d.licenseRequired is bool)
        && (!('fishingLicenseUrl' in d) || link(d.fishingLicenseUrl))
        // Engelsk översättning av texterna.
        && (!('descriptionEn' in d) || text(d.descriptionEn, 3000))
        && (!('accommodationInfoEn' in d) || text(d.accommodationInfoEn, 1000))
        && (!('boatInfoEn' in d) || text(d.boatInfoEn, 1000))
        && (!('priceEn' in d) || text(d.priceEn, 1000))
        && (!('fishingLicenseEn' in d) || text(d.fishingLicenseEn, 1000));
    }

    // Samma listor som i config.js.
    function validSpot(d) {
      return d.keys().hasOnly(spotKeys().concat(optionalKeys())) && d.keys().hasAll(spotKeys())
        && validOptional(d)
        && text(d.name, 100) && d.name.size() > 0
        && text(d.lake, 100) && d.lake.size() > 0
        && d.county in ['Blekinge län', 'Dalarnas län', 'Gotlands län', 'Gävleborgs län',
          'Hallands län', 'Jämtlands län', 'Jönköpings län', 'Kalmar län', 'Kronobergs län',
          'Norrbottens län', 'Skåne län', 'Stockholms län', 'Södermanlands län', 'Uppsala län',
          'Värmlands län', 'Västerbottens län', 'Västernorrlands län', 'Västmanlands län',
          'Västra Götalands län', 'Örebro län', 'Östergötlands län']
        && text(d.place, 100)
        // Grov ruta runt Sverige.
        && d.lat is number && float(d.lat) >= 55.0 && float(d.lat) <= 69.5
        && d.lng is number && float(d.lng) >= 10.5 && float(d.lng) <= 24.5
        && text(d.description, 3000)
        && d.hasAccommodation is bool && text(d.accommodationInfo, 1000)
        && d.hasBoats is bool && text(d.boatInfo, 1000)
        && d.species is list && d.species.size() <= 8
        && d.species.hasOnly(['gädda', 'abborre', 'gös', 'öring', 'röding', 'harr', 'lax', 'regnbåge'])
        && text(d.price, 1000) && text(d.fishingLicense, 1000)
        && link(d.website) && link(d.imageUrl)
        && text(d.phone, 30) && text(d.email, 100)
        && d.updatedAt == request.time;
    }

    match /spots/{id} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();

      // Nya ställen från användare hamnar alltid i granskningskön, i eget namn.
      allow create: if signedIn()
        && validSpot(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'owner'
        && request.resource.data.sourceUrl == '';

      // Ägaren får ändra innehållet men inte ägarskap, status eller ursprung.
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && validSpot(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.source == resource.data.source
          && request.resource.data.sourceUrl == resource.data.sourceUrl);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Anspråk på ett ställe utan ägare. Bara admin kan godkänna (sätter ownerUid på stället).
    match /claims/{id} {
      allow read, delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['spotId', 'uid', 'email', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['spotId', 'uid', 'email', 'message', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && id == request.resource.data.spotId + '_' + request.auth.uid
        && text(request.resource.data.message, 1000) && request.resource.data.message.size() > 0
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/spots/$(request.resource.data.spotId)).data.ownerUid == null;
    }

    // Uppladdad bild per ställe (JPEG som data-URL). Samma behörighet som stället självt.
    match /images/{spotId} {
      function spotData() {
        return get(/databases/$(database)/documents/spots/$(spotId)).data;
      }
      function canEdit() {
        return isAdmin() || (signedIn() && spotData().ownerUid == request.auth.uid);
      }

      allow read: if spotData().status == 'published' || canEdit();
      allow delete: if canEdit();
      allow create, update: if canEdit()
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000
        && request.resource.data.updatedAt == request.time;
    }

    // Sparade spots (stjärnan): en lista per konto, som bara kontots ägare kan läsa och ändra.
    match /favorites/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
        && request.resource.data.ids is list
        && request.resource.data.ids.size() <= 500
        && request.resource.data.updatedAt == request.time;
    }

    // Admins läggs in med scripts/make-admin.mjs, aldrig från webbläsaren.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
  }
}
